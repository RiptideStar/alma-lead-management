# Copy to .env: `cp .env.example .env`
# Defaults below work out-of-the-box with `docker compose up`.

# ---------- Backend: database ----------
# Native dev points at localhost:5433 (the compose `db` is exposed there to avoid
# clashing with a local Postgres on 5432). docker-compose overrides host to `db:5432`.
DATABASE_URL=postgresql+psycopg://alma:alma@localhost:5433/alma

# ---------- Backend: auth ----------
JWT_SECRET=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Seeded attorney account for the internal UI (created on startup).
ATTORNEY_EMAIL=attorney@alma.com
ATTORNEY_PASSWORD=almapassword
ATTORNEY_NAME=Alex Attorney

# ---------- Backend: email ----------
# EMAIL_BACKEND: "smtp" (uses Mailpit locally) or "console" (logs to stdout)
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM="Alma Leads <no-reply@alma.com>"
# Where new-lead notifications go (the attorney inbox). Defaults to ATTORNEY_EMAIL.
LEAD_NOTIFICATION_EMAIL=attorney@alma.com

# ---------- Backend: file storage ----------
# STORAGE_BACKEND: "local" or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ---------- Backend: misc ----------
# Comma-separated allowed CORS origins for the public form.
ALLOWED_ORIGINS=http://localhost:3000
# Link the attorney email points to (internal UI).
INTERNAL_APP_URL=http://localhost:3000/admin/leads

# ---------- Frontend ----------
# Server-side (BFF) backend base URL. docker-compose overrides to http://backend:8000.
BACKEND_URL=http://localhost:8000
# Browser-facing API base URL (used by the public lead form).
NEXT_PUBLIC_API_URL=http://localhost:8000
